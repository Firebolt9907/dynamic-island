<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors the view ids ESPN's live score notification exposes, including leader rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tv_status_secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/team_one_possession"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:src="@android:drawable/presence_online"
        android:contentDescription="Possession"
        android:visibility="gone" />
    <ImageView
        android:id="@+id/team_two_possession"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:src="@android:drawable/presence_online"
        android:contentDescription="Possession"
        android:visibility="gone" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/layout_live_team_one_block"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/iv_team_one_logo"
                android:layout_width="28dp"
                android:layout_height="28dp" />
            <TextView
                android:id="@+id/tv_live_team_one_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="#FFFFFF" />
            <TextView
                android:id="@+id/tv_live_team_one_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_status_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:textColor="#A5A5AD" />

        <LinearLayout
            android:id="@+id/layout_live_team_two_block"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tv_live_team_two_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF" />
            <TextView
                android:id="@+id/tv_live_team_two_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#FFFFFF" />
            <ImageView
                android:id="@+id/iv_team_two_logo"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </RelativeLayout>

    <TextView
        android:id="@+id/tv_game_notes_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#A5A5AD" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/iv_note_avatar_first"
            android:layout_width="20dp"
            android:layout_height="20dp" />
        <TextView
            android:id="@+id/tv_note_label_first"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="#FFFFFF" />
        <TextView
            android:id="@+id/tv_note_message_first"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#A5A5AD" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/iv_note_avatar_second"
            android:layout_width="20dp"
            android:layout_height="20dp" />
        <TextView
            android:id="@+id/tv_note_label_second"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="#FFFFFF" />
        <TextView
            android:id="@+id/tv_note_message_second"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#A5A5AD" />
    </LinearLayout>
</LinearLayout>
